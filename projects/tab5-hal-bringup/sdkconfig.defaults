# Tab5 HAL bring-up defaults (ESP32-P4)

# This Tab5 unit is ESP32-P4 revision v1.3.  ESP-IDF v5.5.5 defaults to
# minimum rev v3.1, which is incompatible with 0.x/1.x silicon.  Select the
# "less than v3" branch and set minimum supported revision to v1.0 so the
# v1.3 chip is accepted.
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_100=y

# 16 MB flash on Tab5 (detected size is 16384k).
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# 32 MB PSRAM on Tab5
CONFIG_SPIRAM=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# SD/MMC FAT filesystem
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=128
CONFIG_FATFS_API_ENCODING_UTF_8=y

# Log over UART (the USB-serial/JTAG bridge of the programming port)
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# Larger main task stack for USB/SD/DSI bring-up
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
